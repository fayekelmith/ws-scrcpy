# Docker Compose Environment Variables
# Copy this file to .env and adjust values as needed

# Redroid Configuration
REDROID_VERSION=latest
ADB_PORT=5555
ANDROID_WIDTH=1080
ANDROID_HEIGHT=2340
ANDROID_DPI=420
ANDROID_FPS=60

# ws-scrcpy Configuration
SCRCPY_PORT=8000
BOOT_WAIT=10

# Note: SCRCPY_DEVICE_HOST and SCRCPY_DEVICE_PORT are set in docker-compose.yml
# They don't need to be in this .env file unless you want to override them
